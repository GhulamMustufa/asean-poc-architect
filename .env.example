# ==============================================================================
# ASEAN POC-Architect — Universal Multi-Model AI Gateway Environment Configuration
# ==============================================================================
# ALL CREDENTIALS MUST REMAIN STRICTLY SERVER-SIDE.
# NEVER prefix API keys with NEXT_PUBLIC_ or expose them in client bundles.
#
# Free Tier Notice:
# - Google AI Studio provides free-tier rate limits for Gemma 4 & Gemini models.
# - Groq provides free-tier developer rate limits on LPU-accelerated models.
# - Ollama is completely free, runs locally on Apple Silicon / CPU, zero network required.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE PROVIDER (Cloud Reasoning — Gemma 4 / Gemini)
# ------------------------------------------------------------------------------
# Get your free developer key at: https://aistudio.google.com/
# Supported models:
#   - gemma-4-31b-it (Google Gemma 4 31B Open Weights - Recommended for deep reasoning)
#   - gemma-4-26b-a4b-it (Google Gemma 4 26B Mixture-of-Experts)
#   - gemini-2.0-flash (Ultra-low latency production cloud model)
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# ------------------------------------------------------------------------------
# 2. GROQ PROVIDER (Cloud Ultra-High-Speed LPU Inference)
# ------------------------------------------------------------------------------
# Get your free developer key at: https://console.groq.com/
# Default verified active model:
#   - llama-3.1-8b-instant (Sub-second low latency inference on Groq LPU chips)
#   - llama-3.3-70b-versatile (High capacity reasoning)
# Note: Groq deprecated gemma2-9b-it; llama-3.1-8b-instant is the verified production model.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_ID=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# 3. LOCAL OLLAMA PROVIDER (Edge / Air-Gap Compatible Local Inference)
# ------------------------------------------------------------------------------
# Install Ollama: https://ollama.com/
# To pull verified models on Apple Silicon (8GB+ RAM):
#   ollama pull gemma2:2b
#   ollama pull qwen2.5-coder:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma2:2b

# ------------------------------------------------------------------------------
# 4. GATEWAY EXECUTION TIMEOUTS & DEADLINES (Milliseconds)
# ------------------------------------------------------------------------------
# Recommended defaults tuned for hackathon Wi-Fi and Apple Silicon M1 (8GB):
AI_GATEWAY_CLOUD_TIMEOUT_MS=8000
AI_GATEWAY_LOCAL_TIMEOUT_MS=20000
AI_GATEWAY_OVERALL_DEADLINE_MS=30000
AI_GATEWAY_CACHE_TTL_MS=86400000
